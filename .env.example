# ---- Database (MySQL) ----
# 주의: USERNAME/PASSWORD 같은 일반적인 이름은 OS 환경변수와 충돌하므로 DB_ 접두사 사용
DB_HOST=mysql
DB_PORT=3306
DB_USER=changeme
DB_PASSWORD=changeme
DB_NAME=cctv

# ---- Celery / Redis ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_LOG_FILE=/var/log/celery/worker.log
REDIS_HOST=redis

# ---- 서버 식별 ----
# HLS/이벤트 URL 생성에 사용되는 이 노드의 접근 가능한 IP
HOST_IP=127.0.0.1

# ---- 외부 관제 플랫폼 연동 ----
# 이벤트 발생 시 POST 할 엔드포인트. 미설정 시 로컬로 무시됨
EXTERNAL_EVENT_API=http://localhost

# ---- TensorRT 엔진 경로 (mmdeploy_runtime Detector) ----
TRT_ENGINE_PPE=/tensorrt/ppe
TRT_ENGINE_DL=/tensorrt/dl
TRT_ENGINE_PUBLIC=/tensorrt/public
